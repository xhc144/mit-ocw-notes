&CONTROL
 calculation='scf',prefix='cobalt',restart_mode='from_scratch',pseudo_dir='./pseudo',outdir='./pseudo/cobalt-runs/pressure-fcc-a6.200-m0.0/tmp',tprnfor=.true.,tstress=.true.
