&CONTROL
 calculation='relax',prefix='batio3',restart_mode='from_scratch',
 pseudo_dir='./pseudo',outdir='./tmp-oxygen-relax-d0.014',tstress=.true.,tprnfor=.true.,
 forc_conv_thr=1.d-5,etot_conv_thr=1.d-7,nstep=100,
/
&SYSTEM
 ibrav=1,celldm(1)=7.520000000000,nat=5,ntyp=3,ecutwfc=30,ecutrho=240,
/
&ELECTRONS
 diagonalization='cg',mixing_mode='plain',mixing_beta=.7,conv_thr=1.d-8,electron_maxstep=200,
/
&IONS
 ion_dynamics='bfgs'
/
ATOMIC_SPECIES
 Ba 137.327 Ba.UPF
 Ti 47.88 Ti.UPF
 O 15.9994 O.UPF
ATOMIC_POSITIONS crystal
 Ba 0 0 0 0 0 0
 Ti .5 .5 0.514000000000 0 0 0
 O .5 .5 0 1 1 1
 O .5 0 .5 1 1 1
 O 0 .5 .5 1 1 1
K_POINTS automatic
 4 4 4 1 1 1
